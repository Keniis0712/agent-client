{
  "name": "agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "server": "npm run build && node dist/src/server/main.js",
    "device": "npm run build && node dist/src/device/main.js",
    "generate:codex": "codex app-server generate-ts --out generated/codex"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "ws": "^8.18.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
